# Local development uses SQLite unless this is set. Keep real .env files untracked.
# SPECTRE_DATABASE_URL=postgresql+psycopg://spectre:URL_SAFE_PASSWORD@127.0.0.1:5432/spectre
SPECTRE_ALLOWED_ORIGIN=http://127.0.0.1:3000
SPECTRE_COOKIE_SECURE=false
# Required only for the Compose first-run account. Use 12+ characters.
SPECTRE_INITIAL_PASSWORD=
# Required for Compose. Use a randomly generated URL-safe password.
SPECTRE_DB_PASSWORD=
